# Workshift landing — example env. Zkopiuj do .env.local i wypełnij.

# === Resend (newsletter, kontakt) ===
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=...
RESEND_FROM_EMAIL=kontakt@workshift.pl
RESEND_NOTIFY_TO=kontakt@workshift.pl
RESEND_DOI_SECRET=...
RESEND_CONFIRM_URL=https://workshift.pl/#/potwierdz-email
RESEND_DOI_REDIRECT_URL=https://workshift.pl/#/dziekuje-za-zapis
RESEND_WEBHOOK_SECRET=whsec_...

# === Meta Ads (Marketing API — scripts/meta-campaign-setup.mjs) ===
# Token systemowego użytkownika (Business Settings → Użytkownicy systemowi →
# Wygeneruj token; scope: ads_management). NIGDY nie commituj prawdziwego tokenu.
META_SYSTEM_USER_TOKEN=EAA...
# Konto reklamowe, np. act_1234567890 (bez tego skrypt wylistuje dostępne)
META_AD_ACCOUNT_ID=act_...

# === Meta Conversions API (CAPI) — api/meta-capi.js + api/audyt-submit.js ===
# Server-side mirror eventów pixela (InitiateCheckout, Lead) z dedup po event_id.
# Odpala się tylko za zgodą marketingową (RODO).
# ID pixela/datasetu (to samo co META_PIXEL_ID w src/lib/consent.js).
META_PIXEL_ID=1350172243839037
# Token Conversions API (Events Manager → Dataset → Settings → Conversions API →
# Generate access token). Jeśli pusty, użyty zostanie META_SYSTEM_USER_TOKEN.
META_CAPI_TOKEN=
# Opcjonalnie: kod z „Test Events" w Events Managerze (walidacja bez zaśmiecania danych).
META_TEST_EVENT_CODE=

# === Social publishing (scripts/social-posts.js) ===
# Token użytkownika/systemowy ze scope: pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish, business_management.
# NIGDY nie commituj prawdziwego tokenu.
SOCIAL_ACCESS_TOKEN=EAA...
# Opcjonalnie: ID strony FB (bez tego skrypt wylistuje dostępne)
SOCIAL_PAGE_ID=
# Opcjonalnie: baza URL grafik (domyślnie https://workshift.pl/social)
SOCIAL_ASSET_BASE=

# === Offer pages (private offers — /oferta/[slug]) ===
# Sekret HMAC: generuj `openssl rand -hex 32`
OFFER_JWT_SECRET=...
# Hasła per slug — pattern OFFER_PASSWORD_<SLUG_UPPER>
OFFER_PASSWORD_INFORMAX=...
# Dane oferty (PRODUKCJA tylko) — pattern OFFER_DATA_<SLUG_UPPER>.
# Lokalnie nie wpisuj — używany jest plik api/_data/offers/<slug>.js (gitignored).
# Na produkcji wygeneruj base64 przez: npm run offer:encode -- <slug>
# OFFER_DATA_INFORMAX=...base64-encoded-json...
