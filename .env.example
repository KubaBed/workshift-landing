# Workshift landing — example env. Zkopiuj do .env.local i wypełnij.

# === Resend (newsletter, kontakt) ===
RESEND_API_KEY=re_...
RESEND_AUDIENCE_ID=...
RESEND_FROM_EMAIL=kontakt@workshift.pl
RESEND_NOTIFY_TO=kontakt@workshift.pl
RESEND_DOI_SECRET=...
RESEND_CONFIRM_URL=https://workshift.pl/#/potwierdz-email
RESEND_DOI_REDIRECT_URL=https://workshift.pl/#/dziekuje-za-zapis
RESEND_WEBHOOK_SECRET=whsec_...

# === Meta Ads (Marketing API — scripts/meta-campaign-setup.mjs) ===
# Token systemowego użytkownika (Business Settings → Użytkownicy systemowi →
# Wygeneruj token; scope: ads_management). NIGDY nie commituj prawdziwego tokenu.
META_SYSTEM_USER_TOKEN=EAA...
# Konto reklamowe, np. act_1234567890 (bez tego skrypt wylistuje dostępne)
META_AD_ACCOUNT_ID=act_...

# === Offer pages (private offers — /oferta/[slug]) ===
# Sekret HMAC: generuj `openssl rand -hex 32`
OFFER_JWT_SECRET=...
# Hasła per slug — pattern OFFER_PASSWORD_<SLUG_UPPER>
OFFER_PASSWORD_INFORMAX=...
# Dane oferty (PRODUKCJA tylko) — pattern OFFER_DATA_<SLUG_UPPER>.
# Lokalnie nie wpisuj — używany jest plik api/_data/offers/<slug>.js (gitignored).
# Na produkcji wygeneruj base64 przez: npm run offer:encode -- <slug>
# OFFER_DATA_INFORMAX=...base64-encoded-json...
