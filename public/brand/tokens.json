{
  "$description": "Workshift design tokens 1.0 (format W3C Design Tokens)",
  "color": {
    "sage": {
      "$type": "color",
      "$value": "#E6E8DD",
      "$description": "Tło strony i grafik (domyślne)"
    },
    "lime": {
      "$type": "color",
      "$value": "#9CE069",
      "$description": "Jedyny akcent: CTA, wyróżnienie, przesunięta warstwa"
    },
    "lime-deep": {
      "$type": "color",
      "$value": "#81C44E",
      "$description": "Wyłącznie drugi stop gradientu sygnetu"
    },
    "ink": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Tekst; tło sekcji i grafik ciemnych"
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Karty na sage; tekst na czarnym"
    },
    "muted-dark": {
      "$type": "color",
      "$value": "#595959",
      "$description": "Tekst drugorzędny, metadane"
    },
    "muted-light": {
      "$type": "color",
      "$value": "#AAAAAA",
      "$description": "Podpisy, placeholdery, elementy wyłączone"
    },
    "destructive": {
      "$type": "color",
      "$value": "#DD453D",
      "$description": "Tylko błędy. Nigdy dekoracja"
    }
  },
  "dimension": {
    "radius-none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "radius-default": {
      "$type": "dimension",
      "$value": "10px"
    },
    "radius-card": {
      "$type": "dimension",
      "$value": "20px"
    },
    "radius-panel": {
      "$type": "dimension",
      "$value": "24px"
    },
    "radius-pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "space-xs": {
      "$type": "dimension",
      "$value": "8px"
    },
    "space-sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "space-md": {
      "$type": "dimension",
      "$value": "24px"
    },
    "space-lg": {
      "$type": "dimension",
      "$value": "48px"
    },
    "space-xl": {
      "$type": "dimension",
      "$value": "96px"
    },
    "space-section": {
      "$type": "dimension",
      "$value": "112px"
    },
    "space-container": {
      "$type": "dimension",
      "$value": "1320px"
    },
    "space-gutter": {
      "$type": "dimension",
      "$value": "24px"
    },
    "space-gutter-mobile": {
      "$type": "dimension",
      "$value": "16px"
    }
  },
  "fontFamily": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "0.2s"
    },
    "enter": {
      "$type": "duration",
      "$value": "0.8s"
    }
  },
  "cubicBezier": {
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.21,
        0.47,
        0.32,
        0.98
      ]
    }
  }
}
