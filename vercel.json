{
  "rewrites": [
    {
      "source": "/demo/pet-sales/",
      "destination": "/demo/pet-sales/index.html"
    },
    {
      "source": "/demo/pet-sales",
      "destination": "/demo/pet-sales/index.html"
    },
    {
      "source": "/cdv-warsztaty",
      "destination": "/cdv-warsztaty/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/showcase",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/oferta/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/cdv-warsztaty(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
