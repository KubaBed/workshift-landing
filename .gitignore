# Pliki z sekretami konczace sie na .env (np. PostHog_API.env) - regula `.env.*`
# lapie tylko te ZACZYNAJACE sie od `.env`. Sekrety trzymaj w ~/.secrets/workshift/, nie w repo.
*.env
*.env.rtf

# --- Niepubliczne (repo jest PUBLICZNE) - poziom KATALOGU, nie wyliczaj plikow ---
# Nowy plan kampanii, handoff, notatka sprzedazowa -> docs/internal/<podkatalog>/, nie root.
docs/internal/
# Oferty klientow: zrodla (analizy, drafty maili, generatory) i wygenerowane PDF-y
offers/
# Wizytowki i materialy do druku (binaria + zdjecie prywatne)
assets/print/
# Notatki projektowe z nazwami klientow i cenami; kontekst agenta z pipeline'em
NOTES.md
CLAUDE.md
diary/
stash/

# Dane ofert w kodzie (kod publiczny, tresc klientow nie - RODO)
src/data/offers/*.js
!src/data/offers/index.js
!src/data/offers/*.example.js
api/_data/offers/*.js
api/_data/offers/_views.json
!api/_data/offers/*.example.js
public/offers/

# Root ma byc czysty: zadnych binariow ani dokumentow luzem na najwyzszym poziomie.
# Dokumenty -> docs/, assety -> assets/ lub public/. Wzorce z "/" dzialaja TYLKO w roocie.
/*.pdf
/*.doc
/*.docx
/*.zip
/*.png
/*.jpg
/*.rtf
/*.txt

